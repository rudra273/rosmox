# Public site URL — used for canonical links, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://rosmox.com

# Contact form delivery (Resend — https://resend.com)
# Without RESEND_API_KEY the form logs enquiries in development and
# shows an "email us instead" error in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@rosmox.com
CONTACT_FROM_EMAIL="ROSMOX Website <website@rosmox.com>"

# Vidya AI account-deletion requests (Resend). Key goes in .env.local only.
DELETE_TO_EMAIL=rosmoxx@gmail.com
