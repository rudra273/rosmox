# Public site URL — used for canonical links, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://rosmox.com

# Contact form delivery (Brevo — https://brevo.com)
# Without BREVO_API_KEY the form logs enquiries in development and
# shows an "email us instead" error in production.
BREVO_API_KEY=
CONTACT_TO_EMAIL=business@rosmox.com
CONTACT_CC_EMAIL=
CONTACT_FROM_EMAIL="ROSMOX Website <business@rosmox.com>"

# Vidyakalp account-deletion requests (Brevo). Key goes in .env.local only.
DELETE_TO_EMAIL=admin@rosmox.com
DELETE_CC_EMAIL=
